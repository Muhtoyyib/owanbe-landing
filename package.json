{
  "name": "owanbespace-landing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "vp run generate && vp build && tsc -b",
    "ci:build": "vp run generate && vp run lint && vp test --run && vp run build",
    "cf:upload": "wrangler versions upload --tag \"$(git rev-parse --short=12 HEAD)\" --message \"main $(git rev-parse --short=12 HEAD)\"",
    "clean": "rm -rf dist",
    "dev": "vp dev --force",
    "generate": "fumadocs-mdx && vp run generate:paraglide",
    "generate:paraglide": "node scripts/generate-paraglide.ts",
    "start": "vp preview",
    "serve": "vp dlx serve@latest --no-port-switching -c serve.json dist/client -l tcp://127.0.0.1:4173",
    "serve:spa": "vp dlx serve@latest --no-port-switching -s dist/client -l tcp://127.0.0.1:4173",
    "blog:preview": "node scripts/blog-preview.ts",
    "lint": "vp lint --max-warnings=0 --no-error-on-unmatched-pattern",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt",
    "prepare": "vp config",
    "test": "vp test",
    "test:ui": "vp test --ui",
    "test:coverage": "vp test --coverage",
    "stryker": "stryker run",
    "stryker:incremental": "stryker run --incremental",
    "typecheck": "vp run generate && paraglide-js compile --project ./project.inlang --outdir ./src/paraglide && tsc -b --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/gayathri": "^5.2.5",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/react-router": "^1.170.38",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-start": "^1.168.57",
    "@tanstack/start-static-server-functions": "^1.167.37",
    "class-variance-authority": "^0.7.1",
    "cn": "0.3.2",
    "fumadocs-core": "^16.15.12",
    "fumadocs-mdx": "^15.4.3",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.13.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@inlang/cli": "^3.3.7",
    "@inlang/paraglide-js": "^2.25.4",
    "@shadcn/lint": "^0.1.5",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/typescript-checker": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/mdx": "^2.0.14",
    "@types/node": "26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.0",
    "oxc-transform-react": "0.151.0",
    "react-doctor": "^0.9.14",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plus": "1.0.0",
    "wrangler": "^4.136.1"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2",
      "onFail": "download"
    }
  },
  "packageManager": "bun@1.4.2"
}
