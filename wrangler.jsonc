{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "owanbespace-landing",
  "compatibility_date": "2026-03-01",
  "preview_urls": true,
  "previews": {},
  "assets": {
    "directory": "./dist/client",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application",
  },
  "observability": {
    "enabled": true,
  },
}
