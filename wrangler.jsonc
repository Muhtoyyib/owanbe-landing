{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Worker names must be lowercase alphanumeric with dashes; this also becomes
  // the *.workers.dev subdomain, so it can't be "Owanbe Space waitlist".
  "name": "owanbe-space-waitlist",
  "compatibility_date": "2026-08-04",
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
