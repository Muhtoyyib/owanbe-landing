{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "reporters": ["html", "clear-text", "progress"],
  "testRunner": "vitest",
  "coverageAnalysis": "perTest",
  "mutate": ["src/lib/site-config.ts", "src/lib/locale.ts", "!src/**/*.test.*", "!src/**/*.spec.*", "!src/**/*.gen.ts", "!src/**/*.d.ts"],
  "checkers": ["typescript"],
  "tsconfigFile": "tsconfig.json",
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  },
  "tempDirName": ".stryker-tmp",
  "ignorePatterns": [".codex", ".claude", ".agents", "openspec", "AGENTS.md", "CLAUDE.md"]
}
